# Environment Variables for AcadyNoval-IQ

# Gemini AI API Key - Required for AI quiz generation
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# JWT Secret for authentication - Use a secure random string
JWT_SECRET="your-secure-jwt-secret-here"

# Frontend Origin - Set to your domain in production
FRONTEND_ORIGIN="*"

# Node Environment
NODE_ENV="production"

# Render flag (automatically set by Render)
RENDER="true"
